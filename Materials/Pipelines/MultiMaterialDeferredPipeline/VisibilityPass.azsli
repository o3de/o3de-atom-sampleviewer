#pragma once 

#include <Atom/Features/SrgSemantics.azsli>

#define MATERIALPIPELINE_SHADER_HAS_PIXEL_STAGE 0
#define PIPELINE_HAS_PASS_SRG 0

//////////////////////////////////////////////////////////////////////////////////////////////////

#ifdef MATERIAL_TYPE_DEFINES_AZSLI_FILE_PATH
#include MATERIAL_TYPE_DEFINES_AZSLI_FILE_PATH
#endif

//////////////////////////////////////////////////////////////////////////////////////////////////

#include <viewsrg_all.srgi>
#include <scenesrg_all.srgi>
#include <Atom/Features/Pipeline/Forward/ForwardPassVertexData.azsli>
#include <Atom/Features/Pipeline/Forward/ForwardPassPipelineCallbacks.azsli>

//////////////////////////////////////////////////////////////////////////////////////////////////

#include MATERIAL_TYPE_AZSLI_FILE_PATH

//////////////////////////////////////////////////////////////////////////////////////////////////

#include <Atom/Features/Pipeline/Deferred/VisibilityBuffer.azsli>

VsOutput VertexShader(VsInput IN, uint instanceId : SV_InstanceID)
{
    VsSystemValues SV;
    SV.m_instanceId = instanceId;
    VsOutput OUT = EvaluateVertexGeometry(IN, SV, GetMaterialParameters());
    OUT.m_instanceId = instanceId;
    return OUT;
}

struct PsOutput
{
    float4 firstVBuffer: SV_Target0;
    float4 secondVBuffer: SV_Target1;
};

PsOutput PixelShader(VsOutput IN, uint triangleIndex : SV_PrimitiveID, float3 barycentrics : SV_Barycentrics, bool isFrontFace : SV_IsFrontFace)
{
    VisibilityBuffer vbuffer;
    vbuffer.m_meshInfoIndex = DrawSrg::m_meshInfoIndex;
    vbuffer.m_triangleId = triangleIndex;
    vbuffer.m_isFrontFace = isFrontFace;
    vbuffer.m_barycentrics = barycentrics;
    vbuffer.m_barycentricsDx = ddx(barycentrics);
    vbuffer.m_barycentricsDy = ddy(barycentrics);

    PsOutput OUT;
    packVisibilityBuffer(vbuffer, OUT.firstVBuffer, OUT.secondVBuffer);

    return OUT;
}



